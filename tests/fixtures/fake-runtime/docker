#!/usr/bin/env python3
"""A container runtime that holds its containers in a JSON file (R3.6).

`FAKE_RUNTIME_STATE` names the file: {"containers": [{"id", "name", "labels"}],
"calls": [argv, ...]}. It answers the four commands the owner module uses:
`ps -a -q --filter label=K[=V] ...`, `inspect ID...`, `kill NAME...` and
`rm -f NAME...`; a kill removes the container, as `--rm` would.
"""
import json
import os
import sys

path = os.environ["FAKE_RUNTIME_STATE"]
with open(path, encoding="utf-8") as handle:
    state = json.load(handle)
argv = sys.argv[1:]
state.setdefault("calls", []).append(argv)


def matches(container, filters):
    for spec in filters:
        key, _, value = spec.partition("=")
        labels = container.get("labels", {})
        if key not in labels or (value and labels[key] != value):
            return False
    return True


def find(ref):
    return [c for c in state["containers"] if ref in (c["id"], c["name"])]


command = argv[0]
if command == "ps":
    filters = [argv[i + 1].removeprefix("label=") for i, a in enumerate(argv)
               if a == "--filter" and argv[i + 1].startswith("label=")]
    for container in state["containers"]:
        if matches(container, filters):
            print(container["id"])
elif command == "inspect":
    found = [c for ref in argv[1:] for c in find(ref)]
    print(json.dumps([{"Id": c["id"], "Name": "/" + c["name"],
                       "Config": {"Labels": c.get("labels", {})}} for c in found]))
elif command in ("kill", "rm"):
    refs = [a for a in argv[1:] if not a.startswith("-")]
    gone = {c["id"] for ref in refs for c in find(ref)}
    state["containers"] = [c for c in state["containers"] if c["id"] not in gone]
with open(path, "w", encoding="utf-8") as handle:
    json.dump(state, handle)
