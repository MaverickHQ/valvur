{
  "argv": [
    "trivy",
    "fs",
    "/workspace",
    "--cache-dir",
    "/cache/trivy",
    "--disable-telemetry",
    "--skip-version-check",
    "--skip-db-update",
    "--skip-java-db-update",
    "--format",
    "json",
    "--output",
    "/results/trivy.json",
    "--quiet",
    "--scanners",
    "vuln",
    "--include-dev-deps",
    "--ignorefile",
    "/dev/null"
  ],
  "timeout": 600,
  "network": false,
  "flags_shape": [
    "--rm",
    "--user",
    "--read-only",
    "--tmpfs",
    "--cap-drop=ALL",
    "--network=none"
  ]
}
