  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Stop a running scan: its containers are killed, nothing is written, and the previous results (if any) stand. What Ctrl-C does on the command line.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "description": "Absolute path to the project to scan. Defaults to the current directory.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "scan_cancel"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Fetch what a scan reads, now: the image if absent, the vulnerability database, the CISA KEV catalog and the package-name index, into this machine's cache; progress on the way, and the answer is what was fetched. Public data comes in; nothing of any workspace leaves.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "if_stale": {
          "description": "Only what is out of date.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "update",
    "outputSchema": {
      "properties": {
        "fetched": {
          "description": "What was fetched, in order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "said": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false
    },
    "description": "Check that this machine can scan, before scanning: the container runtime, the image, the vulnerability database, the package-name index, SELinux, TLS trust, and which MCP client configuration names valvur. One line per check with the fix on any that would fail a scan. Changes nothing but the containers of scans whose process ended, which it removes.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "network": {
          "description": "Also probe, with one bounded TCP connect per host, whether the registries a first run and the full profile need are reachable from here. Off by default: without it doctor opens no socket.",
          "type": "boolean"
        },
        "workspace": {
          "description": "Absolute path to the project to scan. Defaults to the current directory.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "doctor"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Before adding a dependency: whether each package exists on its registry, is one edit from a far more popular one, was published as malicious, or is exposed to dependency confusion by this project's registry configuration. Answered from this machine's cache; no registry is asked, because asking about a hallucinated name tells whoever watches what to register. Never add a flagged package, or a replacement for it, without asking the human.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "packages": {
          "description": "Up to 50, each {ecosystem, name, version?}.",
          "items": {
            "properties": {
              "ecosystem": {
                "description": "npm, pip, cargo, gem or composer; go and maven answer unknown",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "version": {
                "description": "The version to be installed, when known: some are malicious only at one version.",
                "type": "string"
              }
            },
            "required": [
              "ecosystem",
              "name"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "workspace": {
          "description": "Absolute path to the project to scan. Defaults to the current directory.",
          "type": "string"
        }
      },
      "required": [
        "packages"
      ],
      "type": "object"
    },
    "name": "check_package",
    "outputSchema": {
      "properties": {
        "answers": {
          "items": {
            "properties": {
              "ecosystem": {
                "type": "string"
              },
              "exists": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "flagged": {
                "type": "boolean"
              },
              "ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "index_built": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "near": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verdict": {
                "enum": [
                  "exists",
                  "nonexistent",
                  "near-miss",
                  "malicious",
                  "confusion",
                  "not-public",
                  "unknown"
                ],
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "checked": {
          "type": "integer"
        },
        "flagged": {
          "description": "Answers that should stop an install until the human has looked.",
          "type": "integer"
        }
      },
      "type": "object"
    }
  }
