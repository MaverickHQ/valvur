#!/usr/bin/env python3
"""A stand-in for OSV-Scanner on the reuse tests (R14.3): `osv-scanner scan source
... --output-file FILE DIR` reports MAL-2023-1 for each `package-lock.json`, and says
it ran in the file `FAKE_TOOL_LOG` names."""
import json
import os
import sys

args = sys.argv[1:]
report = args[args.index("--output-file") + 1]
root = args[-1]
if os.environ.get("FAKE_TOOL_LOG"):
    with open(os.environ["FAKE_TOOL_LOG"], "a", encoding="utf-8") as log:
        log.write("osv-scanner\n")
results = []
for dirpath, _dirs, files in os.walk(root):
    if "package-lock.json" in files:
        path = "/workspace/" + os.path.relpath(os.path.join(dirpath, "package-lock.json"), root)
        results.append({"source": {"path": path, "type": "lockfile"}, "packages": [{
            "package": {"name": "@hyperion-util/cookies", "version": "77.77.79",
                        "ecosystem": "npm"},
            "vulnerabilities": [{"id": "MAL-2023-1", "summary": "Malicious code"}]}]})
with open(report, "w", encoding="utf-8") as handle:
    json.dump({"results": results}, handle)
