#!/usr/bin/env python3
"""A stand-in for Trivy on the reuse tests (R14.3): `trivy fs DIR ... --output FILE`
writes one vulnerability for each `package-lock.json`, and says it ran in the file
`FAKE_TOOL_LOG` names, so a test can tell a run from a reused result."""
import json
import os
import sys

args = sys.argv[1:]
root = args[args.index("fs") + 1]
report = args[args.index("--output") + 1]
if os.environ.get("FAKE_TOOL_LOG"):
    with open(os.environ["FAKE_TOOL_LOG"], "a", encoding="utf-8") as log:
        log.write("trivy\n")
results = []
for dirpath, _dirs, files in os.walk(root):
    if "package-lock.json" in files:
        target = os.path.relpath(os.path.join(dirpath, "package-lock.json"), root)
        results.append({"Target": target, "Class": "lang-pkgs", "Type": "npm",
                        "Vulnerabilities": [{
                            "VulnerabilityID": "CVE-2021-23337", "PkgName": "lodash",
                            "InstalledVersion": "4.17.20", "FixedVersion": "4.17.21",
                            "Severity": "HIGH", "Title": "lodash command injection"}]})
with open(report, "w", encoding="utf-8") as handle:
    json.dump({"SchemaVersion": 2, "Results": results}, handle)
